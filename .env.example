# Переменные окружения сайта «Есть идея».
# Все значения необязательны: сайт корректно работает и без них
# (контакты показываются как «уточняются», форма отключается).
# На Railway задаются в разделе Variables сервиса — пересборка не нужна.

# Публичный e-mail для связи. Используется для кнопки «Написать на почту»
# и как запасной вариант отправки формы (mailto), если FORM_ENDPOINT не задан.
CONTACT_EMAIL=

# Ссылка на Telegram (https://t.me/имя). Показывается кнопкой «Написать в Telegram».
CONTACT_TELEGRAM_URL=

# URL, принимающий POST с JSON-телом формы диагностики
# (например, webhook Make/n8n/Formspree или собственный endpoint).
# Если задан — форма отправляет данные через fetch и показывает статус.
FORM_ENDPOINT=

# Публичный адрес сайта без завершающего слэша (https://example.com).
# Нужен для canonical, Open Graph, robots.txt и sitemap.xml.
SITE_URL=

# Порт задаёт платформа (Railway выставляет PORT автоматически). Локально по умолчанию 3000.
# PORT=3000
